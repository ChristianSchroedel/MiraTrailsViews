<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true" >
    <LinearLayout
        style="@style/SunnyPage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" >
        <TextView
            style="@style/PageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/catalog_heading" />
        <com.google.android.material.textfield.TextInputLayout
            style="@style/SunnyInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/search_hint" >
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:minLines="1"
                android:gravity="top"
                android:padding="16dp"
                android:textSize="16sp"
                android:textColor="@color/ink"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/favorites_filter"
            style="@style/SunnyCheckbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/only_favorites" />
        <TextView
            android:id="@+id/list_summary"
            style="@style/BodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />
        <TextView
            android:id="@+id/selection"
            style="@style/BodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/sunny_stat"
            android:padding="12dp"
            android:layout_marginTop="16dp"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:contentDescription="@string/loading"
            android:visibility="gone" />
        <TextView
            android:id="@+id/message"
            style="@style/BodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:visibility="gone" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/walks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginTop="16dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/refresh"
            style="@style/SunnyButton.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/refresh" />
        <include layout="@layout/include_sunny_footer"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
