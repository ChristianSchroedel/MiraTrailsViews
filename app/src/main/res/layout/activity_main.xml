<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/pine" app:titleTextColor="@android:color/white"
        app:navigationIconTint="@android:color/white" />
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host" android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        app:defaultNavHost="true" app:navGraph="@navigation/main_navigation" />
</LinearLayout>
