<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/app_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cream" >
    <TextView
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:background="@color/sky"
        android:paddingStart="20dp"
        android:gravity="center_vertical"
        android:text="@string/design_direction"
        android:textColor="@color/ink"
        android:textSize="10sp"
        android:fontFamily="@font/inter_semibold" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="58dp">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingEnd="48dp"
            android:background="@color/cream"
            app:titleTextColor="@color/ink"
            app:titleTextAppearance="@style/ToolbarTitle"
            app:navigationIconTint="@color/ink" />
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="20dp"
            android:src="@drawable/figma_sun"
            android:importantForAccessibility="no"
            android:contentDescription="@null" />
    </FrameLayout>
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:defaultNavHost="true"
        app:navGraph="@navigation/main_navigation" />
</LinearLayout>
