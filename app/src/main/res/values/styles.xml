<resources>
    <style name="Theme.MiraTrail" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/pine</item>
        <item name="colorPrimaryVariant">@color/pine_dark</item>
        <item name="colorSecondary">@color/coral</item>
        <item name="colorControlNormal">@android:color/white</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/pine_dark</item>
        <item name="android:windowBackground">@color/cream</item>
    </style>
    <style name="PageTitle">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="BodyText">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
</resources>
